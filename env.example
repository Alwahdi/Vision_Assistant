# Vision Assistant Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Settings
APP_NAME=Vision Assistant
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=vision_assistant
POSTGRES_USER=vision_user
POSTGRES_PASSWORD=vision_password
POSTGRES_SSL_MODE=require
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=60000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=RS256
JWT_ISSUER=vision-assistant
JWT_AUDIENCE=vision-assistant-users
JWT_ACCESS_TOKEN_EXPIRE=900
JWT_REFRESH_TOKEN_EXPIRE=604800

# OAuth Configuration (Optional)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_APPLE_CLIENT_ID=your-apple-client-id
OAUTH_APPLE_CLIENT_SECRET=your-apple-client-secret

# AI/ML Configuration
AI_MODEL_CACHE_SIZE=2gb
AI_PROCESSING_TIMEOUT=300
AI_MAX_CONCURRENT_REQUESTS=10
AI_MODEL_PATH=./models

# OpenAI Configuration (for advanced features)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# AWS Configuration (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=vision-assistant-storage
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=vision-assistant@yourdomain.com

# SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=true
LOKI_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/vision-assistant.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Security Configuration
SECURITY_HELMET_ENABLED=true
SECURITY_CORS_ENABLED=true
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW_MS=900000
SECURITY_RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
UPLOAD_MAX_SIZE=50mb
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,audio/wav,audio/mp3
UPLOAD_DESTINATION=./uploads

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_MEMORY=512mb
CACHE_REDIS_PREFIX=vision_assistant:

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_RETRIES=3

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_COLLECT_DEFAULT_METRICS=true
METRICS_PREFIX=vision_assistant_

# Tracing Configuration
TRACING_ENABLED=true
TRACING_SERVICE_NAME=vision-assistant
TRACING_JAEGER_ENDPOINT=http://jaeger-collector:14268/api/traces
TRACING_SAMPLING_RATE=0.1

# Feature Flags
FEATURE_AI_PROCESSING=true
FEATURE_REAL_TIME=true
FEATURE_MULTILINGUAL=true
FEATURE_OFFLINE_MODE=false
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_VOICE_COMMANDS=true
FEATURE_GESTURE_RECOGNITION=false
FEATURE_AR_SUPPORT=false

# External Service URLs
AI_SERVICE_URL=http://localhost:8000
REALTIME_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3003

# Development Configuration
DEBUG=true
DEV_MODE=true
HOT_RELOAD=true
API_DOCS_ENABLED=true
SWAGGER_ENABLED=true

# Production Configuration (override development settings)
# Uncomment and modify for production deployment
# DEBUG=false
# DEV_MODE=false
# HOT_RELOAD=false
# API_DOCS_ENABLED=false
# SWAGGER_ENABLED=false
# SESSION_SECURE=true
# REDIS_TLS=true
# POSTGRES_SSL_MODE=require
